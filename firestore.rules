rules_version = '2';

// ===============================================================
// BursarIQ - Cloud Firestore Security Rules v6
// Firebase Project: bursariq
// Institution: DE PORTAL SCHOOLS, OGIJO
// Academic Session: 2026/2027
// Last Updated: 2026-11-22
// Changelog v6:
//   - Added comprehensive schema validator and routing for collection 17: weeklyPerformance (Subject Teacher continuous assessments)
//   - Added routing and access controls for collection 18: schoolSettings (Institutional configuration & credentials)
//   - Fixed validator field checks (data.keys().hasAll) and optional field constraints
//   - Fully compatible with Firebase Spark Free Tier and Offline-First IndexedDB caching
// ===============================================================
//
// Collections Covered (18 Collections):
// 1. `students`: Learners across Primary, Junior College, Senior College. Arrears & clearance attributes.
// 2. `payments`: Fee transactions, multi-item receipts, arrears deduction tracking.
// 3. `expenses`: School expenditure logs categorized across periods and payment methods.
// 4. `auditLogs`: Append-only security & transactional activity logs. Mutation/deletion blocked.
// 5. `clearance`: Examination clearance passes (5 per A4) and eligibility tracking.
// 6. `stocks`: Inventory management, quantities, prices, low stock alerts.
// 7. `stockSales`: Immutable retail sale logs linked to inventory items.
// 8. `stockRestocks`: Immutable inventory restocking batches and supplier notes.
// 9. `cbtSubmissions`: Student CBT examination submissions and scores.
// 10. `staff`: Staff directory and employment profiles.
// 11. `salaries`: Salary disbursements and payroll entries.
// 12. `staffLoans`: Staff loan advances and repayments.
// 13. `deletedRecords`: Permanent deleted records (tombstones) preventing ghost resurrections.
// 14. `teachers`: Educator credentials, assigned classes, subjects, portal access passwords, and status.
// 15. `attendance`: Daily student roll call sessions, attendanceMap/records, markedBy.
// 16. `examRecords`: Termly continuous assessments (ca1, ca2), exam marks, total score, letter grade, and remark.
// 17. `weeklyPerformance`: Subject teacher weekly performance tracking (notes, behaviour, attentiveness, test scores).
// 18. `schoolSettings`: Institutional branding, address, bank details, and configuration.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Global Security Gate & Helper Functions
    // ===============================================================

    // SECURITY SWITCH:
    // • false: Prototyping & client web admin operations enabled with full structural validation.
    // • true: Strict Firebase Auth enforcement with role/email claim checks.
    function isProductionMode() {
      return false; 
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAuthorizedStaff() {
      return isAuthenticated() && (
        (request.auth.token.keys().hasAny(['role']) && request.auth.token.role in ['admin', 'super_admin', 'bursar', 'records']) ||
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true) ||
        (request.auth.token.keys().hasAny(['email']) && (
          request.auth.token.email.matches(".*@bursariq\\.com$") ||
          request.auth.token.email.matches(".*@deportalschools\\.edu\\.ng$")
        ))
      );
    }

    function canReadData() {
      return isProductionMode() ? isAuthorizedStaff() : true;
    }

    function canWriteData() {
      return isProductionMode() ? isAuthorizedStaff() : true;
    }

    function canDeleteStudent() {
      return isProductionMode() ? isAuthorizedStaff() : true;
    }

    function canDeletePayment() {
      return isProductionMode() ? isAuthorizedStaff() : true;
    }

    function canDeleteExpense() {
      return isProductionMode() ? isAuthorizedStaff() : true;
    }

    // String length & presence checkers
    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    function validOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() >= minLen &&
         request.resource.data[field].size() <= maxLen);
    }

    // ===============================================================
    // Collection Validators
    // ===============================================================

    // 1. STUDENTS
    function isValidStudent(studentId) {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'regNo', 'firstName', 'lastName', 'currentClass', 'enrolledDate']) &&
        data.id == studentId &&
        validStringLength('id', 3, 50) &&
        validStringLength('regNo', 3, 50) &&
        validStringLength('firstName', 1, 60) &&
        validStringLength('lastName', 1, 60) &&
        (!('gender' in data) || data.gender in ['Male', 'Female', 'Other']) &&
        validOptionalString('dob', 0, 30) &&
        validStringLength('currentClass', 1, 50) &&
        validOptionalString('parentName', 0, 100) &&
        validOptionalString('parentPhone', 0, 30) &&
        validOptionalString('parentEmail', 0, 100) &&
        validOptionalString('address', 0, 250) &&
        validStringLength('enrolledDate', 8, 30) &&
        (!('status' in data) || data.status in ['Active', 'Graduated', 'Withdrawn', 'Suspended', 'Inactive']) &&
        (!('arrears' in data) || (data.arrears is number && data.arrears >= 0)) &&
        (!('termFee' in data) || (data.termFee is number && data.termFee >= 0)) &&
        (!('section' in data) || data.section in ['primary', 'junior', 'senior']) &&
        validOptionalString('clearanceStatus', 0, 50) &&
        validOptionalString('clearanceDate', 0, 50) &&
        validOptionalString('examPassId', 0, 50) &&
        validOptionalString('clearanceNote', 0, 250) &&
        validOptionalString('avatar', 0, 3000) &&
        validOptionalString('updatedAt', 0, 50);
    }

    function isStudentUpdateValid(studentId) {
      return isValidStudent(studentId) &&
        request.resource.data.id == resource.data.id;
    }

    // 2. PAYMENTS
    function isValidPayment(paymentId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'id', 'receiptNo', 'studentId', 'studentName', 'studentClass',
          'category', 'categoryName', 'amount', 'paymentMethod',
          'session', 'term', 'date', 'timestamp'
        ]) &&
        data.id == paymentId &&
        validStringLength('id', 3, 50) &&
        validStringLength('receiptNo', 3, 50) &&
        validStringLength('studentId', 3, 50) &&
        validStringLength('studentName', 1, 100) &&
        validStringLength('studentClass', 1, 50) &&
        validStringLength('category', 1, 50) &&
        validStringLength('categoryName', 1, 250) &&
        validOptionalString('description', 0, 1000) &&
        (data.amount is number && data.amount > 0 && data.amount <= 100000000) &&
        validStringLength('paymentMethod', 1, 50) &&
        validOptionalString('reference', 0, 100) &&
        validStringLength('session', 1, 20) &&
        validStringLength('term', 1, 30) &&
        validStringLength('date', 8, 30) &&
        (!('details' in data) || data.details is map) &&
        (!('items' in data) || (data.items is list && data.items.size() <= 50)) &&
        (!('itemCount' in data) || (data.itemCount is number && data.itemCount >= 0)) &&
        (!('arrearsDeducted' in data) || (data.arrearsDeducted is number && data.arrearsDeducted >= 0)) &&
        (!('termFeePaid' in data) || (data.termFeePaid is number && data.termFeePaid >= 0)) &&
        (!('otherFeesPaid' in data) || (data.otherFeesPaid is number && data.otherFeesPaid >= 0)) &&
        (!('section' in data) || data.section in ['primary', 'junior', 'senior']) &&
        validOptionalString('status', 0, 30) &&
        validOptionalString('recordedBy', 0, 100) &&
        (data.timestamp is number && data.timestamp > 0) &&
        validOptionalString('updatedAt', 0, 50);
    }

    function isPaymentUpdateValid(paymentId) {
      return isValidPayment(paymentId) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.receiptNo == resource.data.receiptNo &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.timestamp == resource.data.timestamp;
    }

    // 3. EXPENSES
    function isValidExpense(expenseId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'id', 'description', 'category', 'amount', 'period',
          'date', 'session', 'recordedBy', 'timestamp'
        ]) &&
        data.id == expenseId &&
        validStringLength('id', 3, 70) &&
        validStringLength('description', 1, 500) &&
        validStringLength('category', 1, 100) &&
        (data.amount is number && data.amount > 0 && data.amount <= 1000000000) &&
        data.period in ['daily', 'weekly', 'monthly', 'termly', 'session', 'one_time', 'onetime'] &&
        validStringLength('date', 8, 35) &&
        validStringLength('session', 1, 35) &&
        validOptionalString('term', 0, 35) &&
        validOptionalString('notes', 0, 2000) &&
        validStringLength('recordedBy', 1, 100) &&
        (data.timestamp is number && data.timestamp > 0) &&
        (!('section' in data) || data.section in ['general', 'primary', 'junior', 'senior']) &&
        validOptionalString('account', 0, 50) &&
        validOptionalString('accountName', 0, 100) &&
        validOptionalString('paymentMethod', 0, 50) &&
        validOptionalString('batchId', 0, 70) &&
        (!('items' in data) || (data.items is list && data.items.size() <= 200)) &&
        (!('itemCount' in data) || (data.itemCount is number && data.itemCount >= 0)) &&
        validOptionalString('updatedAt', 0, 50);
    }

    // 4. AUDIT LOGS
    function isValidAuditLog(logId) {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'timestamp', 'date', 'action', 'user', 'details']) &&
        data.id == logId &&
        validStringLength('id', 3, 50) &&
        (data.timestamp is number && data.timestamp > 0) &&
        validStringLength('date', 1, 60) &&
        validStringLength('action', 1, 50) &&
        validStringLength('user', 1, 100) &&
        validStringLength('details', 1, 500);
    }

    // 5. CLEARANCE PASSES
    function isValidClearance(clearanceId) {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'studentId', 'studentName', 'studentClass', 'timestamp']) &&
        data.id == clearanceId &&
        validStringLength('id', 3, 50) &&
        validStringLength('studentId', 3, 50) &&
        validStringLength('studentName', 1, 100) &&
        validStringLength('studentClass', 1, 50) &&
        (data.timestamp is number && data.timestamp > 0) &&
        validOptionalString('passSerial', 0, 50) &&
        validOptionalString('session', 0, 30) &&
        validOptionalString('term', 0, 30) &&
        validOptionalString('issuedBy', 0, 100) &&
        validOptionalString('status', 0, 30);
    }

    // 6. STOCKS
    function isValidStock(stockId) {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'name', 'category', 'unit', 'sellingPrice', 'openingQty', 'session', 'recordedBy', 'timestamp']) &&
        data.id == stockId &&
        validStringLength('id', 3, 70) &&
        validStringLength('name', 1, 200) &&
        validStringLength('category', 1, 100) &&
        validStringLength('unit', 1, 50) &&
        (data.sellingPrice is number && data.sellingPrice >= 0) &&
        (!('costPrice' in data) || (data.costPrice is number && data.costPrice >= 0)) &&
        (data.openingQty is number && data.openingQty >= 0) &&
        (!('quantityLeft' in data) || (data.quantityLeft is number && data.quantityLeft >= 0)) &&
        (!('quantitySold' in data) || (data.quantitySold is number && data.quantitySold >= 0)) &&
        (!('quantityRestocked' in data) || (data.quantityRestocked is number && data.quantityRestocked >= 0)) &&
        (!('totalReceived' in data) || (data.totalReceived is number && data.totalReceived >= 0)) &&
        (!('lowStockThreshold' in data) || (data.lowStockThreshold is number && data.lowStockThreshold >= 0)) &&
        validStringLength('session', 1, 35) &&
        validStringLength('recordedBy', 1, 100) &&
        (data.timestamp is number && data.timestamp > 0) &&
        (!('status' in data) || data.status in ['active', 'inactive']) &&
        validOptionalString('stockStatus', 0, 30) &&
        validOptionalString('description', 0, 500) &&
        validOptionalString('term', 0, 35) &&
        validOptionalString('updatedAt', 0, 50);
    }

    // 7. STOCK SALES
    function isValidStockSale(saleId) {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'stockId', 'stockName', 'quantity', 'sellingPrice', 'totalRevenue', 'date', 'session', 'recordedBy', 'timestamp']) &&
        data.id == saleId &&
        validStringLength('id', 3, 70) &&
        validStringLength('stockId', 3, 70) &&
        validStringLength('stockName', 1, 200) &&
        (data.quantity is number && data.quantity > 0) &&
        (data.sellingPrice is number && data.sellingPrice >= 0) &&
        (data.totalRevenue is number && data.totalRevenue >= 0) &&
        (!('costPrice' in data) || (data.costPrice is number && data.costPrice >= 0)) &&
        (!('totalCost' in data) || (data.totalCost is number && data.totalCost >= 0)) &&
        (!('profit' in data) || data.profit is number) &&
        validStringLength('date', 8, 30) &&
        validStringLength('session', 1, 35) &&
        validStringLength('recordedBy', 1, 100) &&
        (data.timestamp is number && data.timestamp > 0) &&
        validOptionalString('studentId', 0, 50) &&
        validOptionalString('studentName', 0, 150) &&
        validOptionalString('studentClass', 0, 50) &&
        validOptionalString('paymentMethod', 0, 50) &&
        validOptionalString('notes', 0, 500) &&
        validOptionalString('term', 0, 35) &&
        (!('isPaymentLinked' in request.resource.data) || request.resource.data.isPaymentLinked is bool) &&
        validOptionalString('paymentId', 0, 70);
    }

    // 8. STOCK RESTOCKS
    function isValidStockRestock(restockId) {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'stockId', 'stockName', 'quantity', 'date', 'session', 'recordedBy', 'timestamp']) &&
        data.id == restockId &&
        validStringLength('id', 3, 70) &&
        validStringLength('stockId', 3, 70) &&
        validStringLength('stockName', 1, 200) &&
        (data.quantity is number && data.quantity > 0) &&
        (!('costPrice' in data) || (data.costPrice is number && data.costPrice >= 0)) &&
        (!('totalCost' in data) || (data.totalCost is number && data.totalCost >= 0)) &&
        validStringLength('date', 8, 30) &&
        validStringLength('session', 1, 35) &&
        validStringLength('recordedBy', 1, 100) &&
        (data.timestamp is number && data.timestamp > 0) &&
        validOptionalString('supplier', 0, 200) &&
        validOptionalString('invoiceNo', 0, 100) &&
        validOptionalString('notes', 0, 500) &&
        validOptionalString('term', 0, 35) &&
        (!('isPaymentLinked' in request.resource.data) || request.resource.data.isPaymentLinked is bool) &&
        validOptionalString('paymentId', 0, 70);
    }

    // 9. CBT SUBMISSIONS
    function isValidCbtSubmission(submissionId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'id', 'studentId', 'regNo', 'studentName', 'studentClass',
          'baseClass', 'subject', 'score', 'totalQuestions', 'percentage',
          'grade', 'timeSpentSeconds', 'startedAt', 'submittedAt', 'timestamp'
        ]) &&
        data.id == submissionId &&
        validStringLength('id', 3, 100) &&
        validStringLength('studentId', 3, 100) &&
        validStringLength('regNo', 3, 100) &&
        validStringLength('studentName', 1, 120) &&
        validStringLength('studentClass', 1, 60) &&
        (data.baseClass in ['SSS 1', 'SSS 2', 'SSS 3']) &&
        validStringLength('subject', 1, 60) &&
        (data.totalQuestions is number && data.totalQuestions > 0 && data.totalQuestions <= 100) &&
        (data.score is number && data.score >= 0 && data.score <= (('totalQuestions' in data) ? data.totalQuestions : 40)) &&
        (data.percentage is number && data.percentage >= 0 && data.percentage <= 100) &&
        validStringLength('grade', 1, 30) &&
        (data.timeSpentSeconds is number && data.timeSpentSeconds >= 0) &&
        validStringLength('startedAt', 8, 40) &&
        validStringLength('submittedAt', 8, 40) &&
        (data.timestamp is number && data.timestamp > 0) &&
        validOptionalString('session', 0, 30) &&
        validOptionalString('term', 0, 30) &&
        validOptionalString('status', 0, 30) &&
        validOptionalString('gradeLabel', 0, 60) &&
        validOptionalString('submissionReason', 0, 60) &&
        validOptionalString('updatedAt', 0, 50) &&
        (!('details' in data) || (data.details is list && data.details.size() <= 50));
    }

    // 10. TEACHERS DIRECTORY & CREDENTIALS
    function isValidTeacher(teacherId) {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'name', 'phone', 'password']) &&
        data.id == teacherId &&
        validStringLength('id', 3, 70) &&
        validStringLength('name', 1, 120) &&
        validStringLength('phone', 5, 30) &&
        validStringLength('password', 4, 100) &&
        validOptionalString('staffId', 0, 50) &&
        validOptionalString('assignedClass', 0, 60) &&
        (!('assignedClasses' in data) || (data.assignedClasses is list && data.assignedClasses.size() <= 30)) &&
        validOptionalString('role', 0, 60) &&
        (!('subjects' in data) || (data.subjects is list && data.subjects.size() <= 30)) &&
        validOptionalString('status', 0, 30) &&
        (!('createdAt' in data) || data.createdAt == null || (data.createdAt is string && data.createdAt.size() <= 60) || (data.createdAt is number && data.createdAt > 0) || data.createdAt is timestamp) &&
        (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 60) || (data.updatedAt is number && data.updatedAt > 0) || data.updatedAt is timestamp);
    }

    function isTeacherUpdateValid(teacherId) {
      return isValidTeacher(teacherId) &&
        request.resource.data.id == resource.data.id;
    }

    // 11. DAILY ATTENDANCE REGISTER
    function isValidAttendance(attendanceId) {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'date', 'session', 'markedBy']) &&
        data.id == attendanceId &&
        validStringLength('id', 3, 100) &&
        (('className' in data && validStringLength('className', 1, 60)) || ('class' in data && validStringLength('class', 1, 60))) &&
        validStringLength('date', 8, 35) &&
        validStringLength('session', 1, 50) &&
        (!('attendanceMap' in data) || data.attendanceMap is map) &&
        (!('records' in data) || (data.records is list && data.records.size() <= 200)) &&
        validStringLength('markedBy', 1, 100) &&
        validOptionalString('markedByPhone', 0, 30) &&
        (!('markedAt' in data) || data.markedAt == null || (data.markedAt is string && data.markedAt.size() <= 60) || (data.markedAt is number && data.markedAt > 0) || data.markedAt is timestamp) &&
        validOptionalString('remarks', 0, 1000) &&
        validOptionalString('remark', 0, 1000) &&
        (!('presentCount' in data) || (data.presentCount is number && data.presentCount >= 0)) &&
        (!('absentCount' in data) || (data.absentCount is number && data.absentCount >= 0)) &&
        (!('lateCount' in data) || (data.lateCount is number && data.lateCount >= 0)) &&
        (!('excusedCount' in data) || (data.excusedCount is number && data.excusedCount >= 0)) &&
        (!('totalCount' in data) || (data.totalCount is number && data.totalCount >= 0)) &&
        (!('rate' in data) || (data.rate is number && data.rate >= 0)) &&
        (!('timestamp' in data) || (data.timestamp is number && data.timestamp > 0)) &&
        (!('createdAt' in data) || data.createdAt == null || (data.createdAt is string && data.createdAt.size() <= 60) || (data.createdAt is number && data.createdAt > 0) || data.createdAt is timestamp) &&
        (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 60) || (data.updatedAt is number && data.updatedAt > 0) || data.updatedAt is timestamp);
    }

    function isAttendanceUpdateValid(attendanceId) {
      return isValidAttendance(attendanceId) &&
        request.resource.data.id == resource.data.id;
    }

    // 12. EXAMS & REPORT CARD RECORDS
    function isValidExamRecord(recordId) {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'studentId', 'studentName', 'subject', 'term', 'session']) &&
        data.id == recordId &&
        validStringLength('id', 3, 70) &&
        validStringLength('studentId', 3, 70) &&
        validStringLength('studentName', 1, 120) &&
        (('className' in data && validStringLength('className', 1, 60)) || ('class' in data && validStringLength('class', 1, 60))) &&
        validStringLength('subject', 1, 80) &&
        validStringLength('term', 1, 50) &&
        validStringLength('session', 1, 35) &&
        (!('ca1' in data) || (data.ca1 is number && data.ca1 >= 0 && data.ca1 <= 100)) &&
        (!('ca2' in data) || (data.ca2 is number && data.ca2 >= 0 && data.ca2 <= 100)) &&
        (!('exam' in data) || (data.exam is number && data.exam >= 0 && data.exam <= 100)) &&
        (!('total' in data) || (data.total is number && data.total >= 0 && data.total <= 100)) &&
        validOptionalString('grade', 0, 20) &&
        validOptionalString('remark', 0, 150) &&
        (!('syncedFromCbt' in data) || data.syncedFromCbt is bool) &&
        (!('createdAt' in data) || data.createdAt == null || (data.createdAt is string && data.createdAt.size() <= 60) || (data.createdAt is number && data.createdAt > 0) || data.createdAt is timestamp) &&
        (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 60) || (data.updatedAt is number && data.updatedAt > 0) || data.updatedAt is timestamp);
    }

    // 13. WEEKLY STUDENT PERFORMANCE (Subject Teacher Assessment)
    function isValidWeeklyPerformance(perfId) {
      let data = request.resource.data;
      return data.keys().hasAll(['studentId', 'className', 'subject']) &&
        (!('id' in data) || data.id == perfId) &&
        validStringLength('studentId', 1, 60) &&
        validStringLength('className', 1, 50) &&
        validStringLength('subject', 1, 80) &&
        validOptionalString('id', 0, 80) &&
        validOptionalString('studentName', 0, 150) &&
        validOptionalString('regNo', 0, 50) &&
        validOptionalString('week', 0, 30) &&
        validOptionalString('term', 0, 50) &&
        validOptionalString('session', 0, 35) &&
        validOptionalString('notes', 0, 50) &&
        validOptionalString('behaviour', 0, 50) &&
        validOptionalString('attentiveness', 0, 50) &&
        validOptionalString('teacherRemark', 0, 300) &&
        validOptionalString('recordedBy', 0, 100) &&
        (!('testScore' in data) || (data.testScore is number && data.testScore >= 0 && data.testScore <= 100)) &&
        (!('createdAt' in data) || data.createdAt == null || (data.createdAt is string && data.createdAt.size() <= 60) || (data.createdAt is number && data.createdAt > 0) || data.createdAt is timestamp) &&
        (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 60) || (data.updatedAt is number && data.updatedAt > 0) || data.updatedAt is timestamp);
    }

    function isExamRecordUpdateValid(recordId) {
      return isValidExamRecord(recordId) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.studentId == resource.data.studentId;
    }

    // ===============================================================
    // Rules Routing
    // ===============================================================

    // 1. STUDENTS
    match /students/{studentId} {
      allow read: if canReadData();
      allow create: if canWriteData() && isValidStudent(studentId);
      allow update: if canWriteData() && isStudentUpdateValid(studentId);
      allow delete: if canDeleteStudent();
    }

    // 2. PAYMENTS
    match /payments/{paymentId} {
      allow read: if canReadData();
      allow create: if canWriteData() && isValidPayment(paymentId);
      allow update: if canWriteData() && isPaymentUpdateValid(paymentId);
      allow delete: if canDeletePayment();
    }

    // 3. EXPENSES
    match /expenses/{expenseId} {
      allow read: if canReadData();
      allow create: if canWriteData() && isValidExpense(expenseId);
      allow update: if canWriteData() && isValidExpense(expenseId);
      allow delete: if canDeleteExpense();
    }

    // 4. AUDIT LOGS (Append-Only)
    match /auditLogs/{logId} {
      allow read: if canReadData();
      allow create: if canWriteData() && isValidAuditLog(logId);
      allow update: if false; // Immutable
      allow delete: if false; // Permanent audit trail
    }

    // 5. CLEARANCE PASSES
    match /clearance/{clearanceId} {
      allow read: if canReadData();
      allow create: if canWriteData() && isValidClearance(clearanceId);
      allow update: if canWriteData() && isValidClearance(clearanceId);
      allow delete: if canWriteData();
    }

    // 6. STOCKS
    match /stocks/{stockId} {
      allow read: if canReadData();
      allow create: if canWriteData() && isValidStock(stockId);
      allow update: if canWriteData() && isValidStock(stockId);
      allow delete: if canWriteData();
    }

    // 7. STOCK SALES
    match /stockSales/{saleId} {
      allow read: if canReadData();
      allow create: if canWriteData() && isValidStockSale(saleId);
      allow update: if false; // Immutable sales
      allow delete: if canWriteData();
    }

    // 8. STOCK RESTOCKS
    match /stockRestocks/{restockId} {
      allow read: if canReadData();
      allow create: if canWriteData() && isValidStockRestock(restockId);
      allow update: if false; // Immutable restocks
      allow delete: if canWriteData();
    }

    // 9. CBT SUBMISSIONS
    match /cbtSubmissions/{submissionId} {
      allow read: if canReadData();
      allow create: if canWriteData() && isValidCbtSubmission(submissionId);
      allow update: if false; // Immutability of submitted exam scores
      allow delete: if canWriteData(); // Admins can clear/reset an attempt if requested
    }

    // 10. STAFF DIRECTORY
    match /staff/{staffId} {
      allow read: if canReadData();
      allow create, update: if canWriteData();
      allow delete: if canWriteData();
    }

    // 11. SALARY DISBURSEMENTS
    match /salaries/{salaryId} {
      allow read: if canReadData();
      allow create, update: if canWriteData();
      allow delete: if canWriteData();
    }

    // 12. STAFF LOANS & REPAYMENTS
    match /staffLoans/{loanId} {
      allow read: if canReadData();
      allow create, update: if canWriteData();
      allow delete: if canWriteData();
    }

    // 13. PERMANENT DELETED RECORDS (TOMBSTONES)
    // Ensures deletions on any device propagate everywhere and prevents ghost resurrections
    match /deletedRecords/{recordId} {
      allow read: if canReadData();
      allow create, update: if canWriteData();
      allow delete: if canWriteData();
    }

    // 14. TEACHERS DIRECTORY & CREDENTIALS
    match /teachers/{teacherId} {
      allow read: if canReadData();
      allow create: if canWriteData() && isValidTeacher(teacherId);
      allow update: if canWriteData() && isTeacherUpdateValid(teacherId);
      allow delete: if canWriteData();
    }

    // 15. DAILY ATTENDANCE REGISTER
    match /attendance/{attendanceId} {
      allow read: if canReadData();
      allow create: if canWriteData() && isValidAttendance(attendanceId);
      allow update: if canWriteData() && isAttendanceUpdateValid(attendanceId);
      allow delete: if canWriteData();
    }

        // 16. EXAMS & REPORT CARD RECORDS
    match /examRecords/{recordId} {
      allow read: if canReadData();
      allow create: if canWriteData() && isValidExamRecord(recordId);
      allow update: if canWriteData() && isExamRecordUpdateValid(recordId);
      allow delete: if canWriteData();
    }

    // 17. WEEKLY STUDENT PERFORMANCE (Subject Teacher Assessment)
    match /weeklyPerformance/{perfId} {
      allow read: if canReadData();
      allow create, update: if canWriteData() && isValidWeeklyPerformance(perfId);
      allow delete: if canWriteData();
    }

    // 18. SCHOOL SETTINGS / CONFIGURATION
    match /schoolSettings/{settingId} {
      allow read: if canReadData();
      allow create, update: if canWriteData();
      allow delete: if canWriteData();
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
